// Variant of pqtg-relay-handshake.vp with the pin REMOVED: the client trusts
// the server key it receives on the wire, which is what relay::client_handshake
// did before 2026-09-12 (PinPolicy::Unpinned today). One-line diff from the
// base: `Server -> Client: [server_pk]` -> `Server -> Client: server_pk`.
// With no QKD leg there is nothing to fall back on.

attacker[active]

principal Server[
    knows public label_c2s, label_s2c
    knows private server_sk
    server_pk = PUBKEY(server_sk)
    generates server_random
]

principal Client[
    knows public label_c2s, label_s2c
    knows private client_sk
    client_pk = PUBKEY(client_sk)
    generates client_random
    generates kem_sk
    kem_ek = PUBKEY(kem_sk)
]

Server -> Client: server_pk

Client -> Server: client_random, kem_ek, client_pk

principal Server[
    generates kem_r
    kem_ss, kem_ct = KEM_ENCAP(kem_ek, kem_r)
    transcript_s = HASH(HASH(client_random, server_random, kem_ek), kem_ct, client_pk, server_pk)
    transcript_sig = SIGN(server_sk, transcript_s)
    key_s2c_s = HASH(label_s2c, kem_ss, transcript_s)
    key_c2s_s = HASH(label_c2s, kem_ss, transcript_s)
]

Server -> Client: server_random, kem_ct, transcript_sig

principal Client[
    kem_ss_c = KEM_DECAP(kem_sk, kem_ct)
    transcript_c = HASH(HASH(client_random, server_random, kem_ek), kem_ct, client_pk, server_pk)
    _ = SIGNVERIF(server_pk, transcript_c, transcript_sig)?
    key_c2s_c = HASH(label_c2s, kem_ss_c, transcript_c)
    key_s2c_c = HASH(label_s2c, kem_ss_c, transcript_c)
]

queries[
    confidentiality? key_s2c_s
    confidentiality? key_c2s_s
    confidentiality? key_c2s_c
    confidentiality? key_s2c_c
    authentication? Server -> Client: transcript_sig
    authentication? Client -> Server: kem_ek
]
